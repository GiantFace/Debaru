# Debaru — környezeti változók (másold .env.local-ba és töltsd ki éles értékkel)

# Google Analytics 4 mérőazonosító. Ha üres, nem tölt be analitikát.
# A sütibanneren az "Összes elfogadása" után aktiválódik.
VITE_GA_ID=

# Cloudflare Turnstile (CAPTCHA) éles site key. Ha üres, a hivatalos TESZT-kulcs
# fut (mindig átenged) — élesben KÖTELEZŐ kitölteni.
VITE_TURNSTILE_SITE_KEY=
